# 0.0.0.0 es necesario para que el frontend en Docker llegue vía host.docker.internal.
# Con 127.0.0.1 el contenedor recibe ECONNREFUSED y Next.js responde 500.
CAMERA_BIND_ADDR=0.0.0.0:5001
ROBOT_BACKEND_URL=http://127.0.0.1:5000
ROBOT_CONFIG_ENDPOINT=/api/config
CAMERA_DATABASE_PATH=data/cameras.sqlite3
