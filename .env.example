# ==============================================================================
# CONFIGURACIÓN GENERAL / DOCKER COMPOSE
# ==============================================================================

# Puerto público en el host para el frontend Next.js
FRONTEND_PORT=4553

# Puerto público en el host para el backend Python (Flask/SocketIO)
BACKEND_PORT=5000

# Ruta local en el host al archivo de configuración de IPs de robots
ROBOT_CONFIG_PATH=./robots_IPS.json

# Ruta local en el host al directorio de recetas
RECIPES_PATH=./recipes

# URL donde el contenedor Docker puede alcanzar el servicio de cámaras en Rust.
# Si el servicio corre nativo en Windows y Docker en Docker Desktop:
CAMERA_SERVICE_URL=http://host.docker.internal:5001


# ==============================================================================
# SERVICIO DE CÁMARAS INDUSTRIALES (Rust / camera-service)
# ==============================================================================

# Dirección IP y puerto donde escuchará el servicio de cámaras.
# Usa 0.0.0.0:5001 para que Docker (host.docker.internal) pueda conectarse.
CAMERA_BIND_ADDR=0.0.0.0:5001

# Ruta al archivo SQLite donde se guardan las asignaciones Robot <-> Cámara
CAMERA_DATABASE_PATH=./data/cameras.sqlite3

# URL del backend Python desde la perspectiva del servicio Rust (en Windows).
# El puerto 5000 está publicado por Docker al host, así que 127.0.0.1:5000 funciona.
ROBOT_BACKEND_URL=http://127.0.0.1:5000

# Ruta del endpoint en el backend para leer la lista de robots.
# NO confundir con ROBOT_CONFIG_PATH (que es la ruta del archivo en el host para Docker).
ROBOT_CONFIG_ENDPOINT=/api/config

# Ruta de instalación del SDK de iRAYPLE (usada en tiempo de compilación por build.rs)
IRAYPLE_SDK_DIR=C:\Program Files\HuarayTech\MV Viewer\Development
